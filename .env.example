# --- Banco de dados -----------------------------------------------------------
# String de conexão do PostgreSQL. Em desenvolvimento local você pode usar
# um Postgres via Docker; em produção, use o banco gerenciado do seu provedor
# (Railway, Render, RDS, Neon, Supabase etc.).
DATABASE_URL="postgresql://usuario:senha@localhost:5432/lms_corporativo"

# --- Auth.js --------------------------------------------------------------------
# URL pública da aplicação. Em desenvolvimento: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"
# Segredo usado para assinar sessões/tokens. Gere um valor aleatório com:
#   openssl rand -base64 32
NEXTAUTH_SECRET="troque-este-valor-por-um-segredo-aleatorio"

# --- Senha padrão ---------------------------------------------------------------
# O sistema não envia e-mail de convite nem de redefinição: todo usuário criado
# (ou redefinido pelo administrador) recebe a senha padrão e é obrigado a
# trocá-la no primeiro acesso. O valor é uma constante da aplicação, definida em
# lib/auth/default-password.ts — não é configurável por variável de ambiente.

# --- Uploads (fotos de perfil, capas de curso, PDFs) -----------------------------
# Opcional. Por padrão os arquivos enviados ficam em `public/uploads`. Se o
# deploy roda em mais de uma instância (cluster/réplicas) ou é recriado a
# partir de um checkout novo a cada deploy, aponte esta variável para um
# volume persistente e compartilhado — MAS ele precisa ficar dentro da pasta
# `public/` do projeto (ex.: montar o volume em `public/uploads` mesmo, ou em
# outro subdiretório de `public/`), senão o Next não consegue servir os
# arquivos e os uploads "funcionam" mas nunca carregam na tela.
# UPLOADS_DIR="/caminho/absoluto/para/lms/public/uploads"
