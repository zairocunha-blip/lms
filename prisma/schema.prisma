// LMS Corporativo — Schema do banco de dados
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identidade e organização
// ---------------------------------------------------------------------------

enum RoleCode {
  ADMIN
  EMPLOYEE
}

model Role {
  id    String   @id @default(cuid())
  code  RoleCode @unique
  name  String
  users User[]

  @@map("roles")
}

model Department {
  id    String @id @default(cuid())
  name  String @unique
  users User[]

  @@map("departments")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String?
  jobTitle     String?
  avatarUrl    String?
  status       UserStatus @default(PENDING)
  hiredAt      DateTime?

  // Quando true, o usuário só consegue navegar para /trocar-senha até definir
  // uma senha própria — é o que força a troca da senha padrão no 1º acesso.
  mustChangePassword Boolean @default(false)

  roleId       String
  role         Role        @relation(fields: [roleId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now()) @updatedAt
  updatedAt DateTime @updatedAt

  coursesCreated   Course[]           @relation("CourseCreatedBy")
  assignmentsGiven CourseAssignment[] @relation("AssignedBy")
  assignments      CourseAssignment[] @relation("AssignedTo")
  lessonProgress   LessonProgress[]
  courseProgress   CourseProgress[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  quizAttempts     QuizAttempt[]
  quizReviews      QuizAttempt[]      @relation("QuizReviewedBy")

  @@index([status])
  @@index([departmentId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Catálogo de cursos
// ---------------------------------------------------------------------------

model Category {
  id       String   @id @default(cuid())
  name     String   @unique
  isActive Boolean  @default(true)
  courses  Course[]

  @@map("categories")
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Course {
  id          String       @id @default(cuid())
  title       String
  description String?
  coverUrl    String?
  status      CourseStatus @default(DRAFT)
  order       Int          @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  // Opcional: excluir o usuário que criou o curso não deve travar a exclusão
  // dele — o curso permanece, apenas perde a referência de quem o criou.
  createdById String?
  createdBy   User?   @relation("CourseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules     CourseModule[]
  assignments CourseAssignment[]
  progress    CourseProgress[]
  quiz        Quiz?

  @@index([status])
  @@index([categoryId])
  @@map("courses")
}

model CourseModule {
  id    String @id @default(cuid())
  title String
  order Int    @default(0)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id    String @id @default(cuid())
  title String
  order Int    @default(0)

  moduleId String
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  content        LessonContent?
  lessonProgress LessonProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
  @@map("lessons")
}

enum LessonContentType {
  MARKDOWN
  SLIDES
}

model LessonContent {
  id       String            @id @default(cuid())
  type     LessonContentType @default(MARKDOWN)
  body     String? // conteúdo Markdown (sanitizado no servidor)
  fileUrl  String? // URL do PDF de apresentação, quando type = SLIDES
  fileName String?

  lessonId String @unique
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@map("lesson_contents")
}

// ---------------------------------------------------------------------------
// Atribuições e progresso
// ---------------------------------------------------------------------------

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model CourseAssignment {
  id     String           @id @default(cuid())
  status AssignmentStatus @default(NOT_STARTED)

  userId String
  user   User   @relation("AssignedTo", fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Opcional pelo mesmo motivo: excluir o admin que atribuiu o curso não pode
  // travar a exclusão dele, nem apagar a atribuição em si.
  assignedById String?
  assignedBy   User?   @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  assignedAt  DateTime  @default(now())
  completedAt DateTime?

  @@unique([userId, courseId])
  @@index([status])
  @@index([courseId])
  @@map("course_assignments")
}

enum ProgressStatus {
  STARTED
  COMPLETED
}

model LessonProgress {
  id     String         @id @default(cuid())
  status ProgressStatus @default(STARTED)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

model CourseProgress {
  id         String @id @default(cuid())
  percentage Int    @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lastLessonId String?

  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("course_progress")
}

// ---------------------------------------------------------------------------
// Provas (avaliação obrigatória para concluir o curso)
// ---------------------------------------------------------------------------

model Quiz {
  id           String  @id @default(cuid())
  title        String  @default("Prova final")
  description  String?
  // Percentual mínimo de acerto para o admin aprovar (referência na correção).
  passingScore Int     @default(70)
  // Quantas vezes o colaborador pode enviar a prova antes de precisar de
  // liberação manual do admin.
  maxAttempts  Int     @default(3)
  // Quando false, a prova existe mas não bloqueia a conclusão do curso.
  isActive     Boolean @default(true)

  courseId String @unique
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quizzes")
}

enum QuizQuestionType {
  OBJECTIVE // múltipla escolha, corrigida automaticamente
  TEXT      // resposta aberta, corrigida pelo admin
}

model QuizQuestion {
  id     String           @id @default(cuid())
  type   QuizQuestionType @default(OBJECTIVE)
  prompt String
  points Int              @default(1)
  order  Int              @default(0)

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  options QuizOption[]
  answers QuizAnswer[]

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizOption {
  id        String  @id @default(cuid())
  text      String
  isCorrect Boolean @default(false)
  order     Int     @default(0)

  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answers QuizAnswer[]

  @@index([questionId])
  @@map("quiz_options")
}

enum QuizAttemptStatus {
  PENDING_REVIEW // enviada, aguardando correção do admin
  APPROVED       // admin aprovou — libera a conclusão do curso
  REJECTED       // admin reprovou — colaborador refaz se ainda houver tentativas
}

model QuizAttempt {
  id          String            @id @default(cuid())
  attemptNo   Int               @default(1)
  status      QuizAttemptStatus @default(PENDING_REVIEW)
  // Acerto automático nas questões objetivas no momento do envio (informativo).
  autoScorePct Int?
  // Nota final atribuída pelo admin ao aprovar/reprovar.
  finalScorePct Int?
  reviewNote  String?
  reviewedById String?
  reviewedBy   User?    @relation("QuizReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  submittedAt  DateTime @default(now())

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  answers QuizAnswer[]

  @@unique([quizId, userId, attemptNo])
  @@index([quizId, status])
  @@index([userId])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id           String   @id @default(cuid())
  textResponse String?
  // Objetivas: definido no envio. Texto: null até o admin corrigir.
  isCorrect    Boolean?
  // Pontos concedidos pelo admin nas questões de texto (nota parcial).
  awardedPoints Int?

  attemptId String
  attempt   QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOptionId String?
  selectedOption   QuizOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@index([attemptId])
  @@map("quiz_answers")
}

// ---------------------------------------------------------------------------
// Notificações e auditoria
// ---------------------------------------------------------------------------

enum NotificationType {
  COURSE_ASSIGNED
  COURSE_COMPLETED
  CONTENT_ADDED
  QUIZ_SUBMITTED
  QUIZ_APPROVED
  QUIZ_REJECTED
}

model Notification {
  id      String           @id @default(cuid())
  type    NotificationType
  message String
  isRead  Boolean          @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id         String  @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  metadata   Json?

  // Opcional: o histórico de auditoria sobrevive à exclusão do usuário que
  // praticou a ação — só perde a referência de quem foi.
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}
